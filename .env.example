# OmRate-AgentOps — copy to .env and set values locally. Do not commit .env.

# Backend API base URL (no trailing slash); replace with your dev/staging host.
OMRATE_BACKEND_BASE_URL=https://api.example.invalid

# MongoDB connection string placeholder; replace user, password, host, and database.
MONGODB_URI=mongodb://USER:PASSWORD@HOST:27017/DATABASE_NAME

# Ruleset or validation bundle version label for traceability.
RULESET_VERSION=0.0.0-placeholder
